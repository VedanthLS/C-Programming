#include <iostream>
using namespace std;

int main()
{
    int num, digit, sum = 0;

    cout << "Enter a number: ";
    cin >> num;

    while (num > 0)
    {
        digit = num % 10;   // Get the last digit
        sum = sum + digit;  // Add the digit to sum
        num = num / 10;     // Remove the last digit
    }

    cout << "Sum of digits = " << sum << endl;

    return 0;
}
