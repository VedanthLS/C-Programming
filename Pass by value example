#include <iostream>
using namespace std;

void changeValue(int num)
{
    num = num + 10;
    cout << "Value inside function: " << num << endl;
}

int main()
{
    int number = 20;

    cout << "Before function call: " << number << endl;

    changeValue(number);

    cout << "After function call: " << number << endl;

    return 0;
}
